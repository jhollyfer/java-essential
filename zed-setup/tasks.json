// Tasks globais do Zed.
// Docs: https://zed.dev/docs/tasks
[
  {
    // Compila o projeto inteiro e roda a classe do arquivo aberto, usando o JDK
    // declarado no .sdkmanrc do projeto (definido pelo comando `jdk-set`).
    // Não depende do PATH nem do default global do sdkman.
    "label": "Java: run",
    "command": "$HOME/.local/bin/zed-java-run",
    "args": ["$ZED_WORKTREE_ROOT", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
]
